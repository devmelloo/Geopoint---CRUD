{
  "info": {
    "name": "GeoPoint API — CRUD completo",
    "_postman_id": "a29d4ed2-6b1b-47a3-8fa8-83e112a645ae",
    "description": "Coleção para testar a API REST GeoPoint. O POST preenche pointId automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "pointId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST — Cadastrar ponto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/points",
        "description": "POST — Cadastrar ponto",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Praça Central\",\n  \"description\": \"Praça principal da cidade\",\n  \"latitude\": -28.2825,\n  \"longitude\": -52.7869\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cadastro retorna 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"pointId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET — Listar todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/points",
        "description": "GET — Listar todos"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Lista retorna 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET — Consultar por UUID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/points/{{pointId}}",
        "description": "GET — Consultar por UUID"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Consulta retorna 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
