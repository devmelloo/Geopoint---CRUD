      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/points/{{pointId}}",
        "description": "PUT — Alterar ponto",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Praça Central Atualizada\",\n  \"description\": \"Praça revitalizada\",\n  \"latitude\": -28.283,\n  \"longitude\": -52.7875\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Alteracao retorna 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
